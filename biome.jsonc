{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/assets",
      "!**/dist",
      "!**/node_modules",
      "!**/static",
      "!**/styles/fonts/fontawesome/FontAwesome.css",
      "!**/*.hbs"
    ]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "css": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": "off",
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    // Overrides for tests
    {
      "includes": ["**/*.{test,spec}.{ts,tsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    // Overrides for stories
    {
      "includes": ["stories/**/*.{tsx,jsx}", "**/*.stories.{tsx,jsx}"],
      "linter": {
        "rules": {
          "correctness": {
            // Neccessary for explicitly setting children to undefined when we need to.
            "noChildrenProp": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": false,
    "useIgnoreFile": true
  }
}

{
  "name": "tgui-modern",
  "description": "SS13 React Component Kit",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "aylong, jlsnow301, stylemistake",
  "homepage": "https://github.com/tgstation/tgui-modern",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "scripts": {
    "create-component": "bun tools/create_component.js",
    "build:rslib": "rslib build",
    "build:storybook": "storybook build",
    "build:rsdoctor": "cross-env RSDOCTOR=true rslib",
    "lint": "biome check lib",
    "lint:fix": "prettier . --write && bun run biome check . --fix",
    "icons": "bun tools/build_icons.js",
    "storybook": "storybook dev -p 6006",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@nozbe/microfuzz": "^1.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.2",
    "overlayscrollbars-react": "^0.5.6",
    "react-hot-toast": "^2.6.1",
    "react-transitioning": "^1.0.9",
    "virtua": "^0.51.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@happy-dom/global-registrator": "^20.11.1",
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsdoctor/core": "^2.0.1",
    "@rslib/core": "^1.0.3",
    "@storybook/addon-docs": "^10.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.8",
    "cross-env": "^10.1.0",
    "fantasticon": "^4.1.0",
    "lightningcss-cli": "^1.33.0",
    "prettier": "^3.9.6",
    "storybook": "^10.1.11",
    "storybook-react-rsbuild": "^3.2.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    "./*": {
      "import": "./dist/common/*.js"
    },
    "./assets/*": {
      "default": "./assets/*"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./styles": {
      "default": "./styles/main.scss"
    },
    "./styles/components": {
      "default": "./dist/components/main.css"
    },
    "./styles/*": {
      "default": "./styles/*"
    }
  },
  "files": [
    "assets",
    "dist",
    "styles"
  ],
  "keywords": [
    "TGUI",
    "SS13",
    "react",
    "library",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tgstation/tgui-modern.git"
  }
}

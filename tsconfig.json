{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ScriptHost"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    /* Set to true when lib will be ready */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      // Do not use barrels there!
      "tgui-modern/*": ["./lib/*.ts", "./lib/*.tsx"],
      "@assets/*": ["./assets/*"],
      "@common/*": ["./lib/common/*.ts"],
      "@styles/*": ["./styles/*.scss"],
      "@stories/*": ["./lib/components/*.stories.tsx", "./stories/*.tsx", "./stories/*.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    /* Linting */
    "strict": false,
    "strictNullChecks": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "types": ["bun", "node"]
  },
  "include": ["lib", "global.d.ts", "react.d.ts", "stories", ".storybook/**/*"]
}
